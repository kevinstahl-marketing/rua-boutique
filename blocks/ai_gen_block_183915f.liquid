{% doc %}
  @prompt
    A simple section to include a logo image with a small gold divider directly under it. Include spacing, width, size, and other adjustments
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-logo-divider-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-top: {{ block.settings.spacing_top }}px;
    padding-bottom: {{ block.settings.spacing_bottom }}px;
    text-align: center;
  }

  .ai-logo-divider-container-{{ ai_gen_id }} {
    display: inline-block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-logo-divider-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: {{ block.settings.divider_spacing }}px;
  }

  .ai-logo-divider-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  .ai-logo-divider-placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    min-height: 100px;
  }

  .ai-logo-divider-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-logo-divider-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    font-size: 12px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-logo-divider-line-{{ ai_gen_id }} {
    width: {{ block.settings.divider_width }}px;
    height: {{ block.settings.divider_height }}px;
    background-color: {{ block.settings.divider_color }};
    margin: 0 auto;
  }

  @media screen and (max-width: 749px) {
    .ai-logo-divider-container-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_width_percent }}%;
    }
  }
{% endstyle %}

<div class="ai-logo-divider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-logo-divider-container-{{ ai_gen_id }}">
    <div class="ai-logo-divider-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.logo %}
        <img
          src="{{ block.settings.logo | image_url: width: 800 }}"
          alt="{{ block.settings.logo.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.logo.width }}"
          height="{{ block.settings.logo.height }}"
          class="ai-logo-divider-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-logo-divider-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-logo-divider-empty-state-{{ ai_gen_id }}">
            Add your logo image
          </div>
        </div>
      {% endif %}
    </div>
    <div class="ai-logo-divider-line-{{ ai_gen_id }}"></div>
  </div>
</div>

{% schema %}
{
  "name": "Logo with divider",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "range",
      "id": "mobile_width_percent",
      "label": "Mobile width",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "header",
      "content": "Divider"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Color",
      "default": "#c5a253"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "Width",
      "min": 20,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "divider_height",
      "label": "Height",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "range",
      "id": "divider_spacing",
      "label": "Space above divider",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "spacing_top",
      "label": "Top spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Logo with divider"
    }
  ]
}
{% endschema %}
